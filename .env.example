# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Nazwa backend jest używana do komunikacji wewnątrz sieci Docker Compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=mzm_db
POSTGRES_USER=mzm_user
POSTGRES_PASSWORD=mzm_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
# Broker przenosi komunikaty z backendu do workera Celery.
CELERY_BROKER_URL=redis://redis:6379/0
# Osobna baza logiczna Redisa przechowuje wyniki zadań.
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Pogoda dla zapisanej lokalizacji pozostaje w Redisie przez 15 minut.
LOCATION_WEATHER_CACHE_TTL=900

# External APIs
WEATHER_API_KEY=your-weather-api-key

# Google OAuth 2.0 / Google Identity Services
# Ten sam publiczny Client ID wpisujemy na backendzie i frontendzie.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
